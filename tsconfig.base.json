{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@cy-monitor/shared": ["./packages/shared/src"],
      "@cy-monitor/utils": ["./packages/utils/src"],
      "@cy-monitor/vue": ["./packages/vue/src"],
      "@cy-monitor/nuxt": ["./packages/nuxt/src"],
      "@cy-monitor/uniapp": ["./packages/uniapp/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
