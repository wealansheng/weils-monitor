{
  "name": "@weils-monitor/replay",
  "version": "1.1.0",
  "description": "Private error-triggered rrweb recording and replay",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "import": "./dist/player.mjs",
      "require": "./dist/player.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-style.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test --config test/playwright.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rrweb/record": "2.1.7",
    "@rrweb/replay": "2.1.7",
    "@rrweb/types": "2.1.7",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@weils-monitor/shared": "workspace:*",
    "vitest": "^3.2.4",
    "vite": "^6.0.0",
    "fake-indexeddb": "^6.2.4",
    "@playwright/test": "^1.56.0"
  }
}
